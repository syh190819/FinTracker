/* 月份选择 */
.month-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12px;
  gap: 16px;
}

.month-nav {
  font-size: 24px;
  color: #1a1a2e;
  padding: 4px 12px;
  font-weight: 300;
}

.month-nav:active {
  opacity: 0.5;
}

.month-label {
  font-size: 16px;
  font-weight: 600;
  color: #1a1a2e;
  min-width: 100px;
  text-align: center;
}

/* 月度概览 */
.summary-card {
  margin-bottom: 0;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12px;
}

.summary-item {
  flex: 1;
}

.summary-label {
  display: block;
  font-size: 12px;
  color: #6b7280;
  margin-bottom: 4px;
}

.summary-amount {
  font-size: 22px;
  font-weight: 700;
  color: #1a1a2e;
}

/* 进度条 */
.progress-bar {
  height: 6px;
  background: #e5e7eb;
  border-radius: 3px;
  overflow: hidden;
  margin-bottom: 6px;
}

.progress-fill {
  height: 100%;
  background: #1a1a2e;
  border-radius: 3px;
  transition: width 0.3s;
}

.progress-text {
  font-size: 11px;
}

/* 预算剩余提示 */
.budget-remaining {
  padding: 10px 16px;
  font-size: 13px;
  color: #1a1a2e;
}

/* 支出列表 */
.expense-list {
  padding: 4px 12px 80px;
}

.expense-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  padding: 12px 16px;
  margin-top: 1px;
  border-radius: 6px;
}

.expense-item:active {
  background: #f5f5f5;
}

.expense-left {
  flex: 1;
}

.expense-category {
  font-size: 14px;
  color: #1a1a2e;
  font-weight: 500;
}

.expense-note {
  display: block;
  font-size: 12px;
  margin-top: 2px;
}

.expense-right {
  text-align: right;
}

.expense-amount {
  font-size: 15px;
  font-weight: 600;
}

.expense-date {
  display: block;
  font-size: 11px;
  margin-top: 2px;
}

/* 弹窗覆盖层 */
.form-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.form-popup {
  background: #ffffff;
  border-radius: 12px 12px 0 0;
  padding: 24px 20px 40px;
  width: 100%;
  box-sizing: border-box;
  max-height: 80vh;
  overflow-y: auto;
}

.form-popup-title {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 20px;
  text-align: center;
}

.picker-value {
  display: flex;
  align-items: center;
  min-height: 40px;
}
