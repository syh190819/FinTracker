.page-auth {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background: #f5f5f5;
  padding: 60px 24px 0;
  box-sizing: border-box;
}

.auth-header {
  text-align: center;
  margin-bottom: 32px;
}

.auth-title {
  font-size: 28px;
  font-weight: 700;
  color: #1a1a2e;
  letter-spacing: 2px;
}

.auth-subtitle {
  display: block;
  font-size: 13px;
  color: #6b7280;
  margin-top: 6px;
}

.auth-form {
  width: 100%;
  max-width: 360px;
  padding: 24px;
}

.form-group {
  margin-bottom: 16px;
}

.form-actions {
  margin-top: 24px;
}

.auth-link {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 16px;
  gap: 4px;
}

.link {
  color: #1a1a2e;
  font-size: 13px;
  font-weight: 500;
  text-decoration: underline;
}

.auth-error {
  text-align: center;
  margin-top: 12px;
  padding: 8px;
  background: #fdf2f2;
  border-radius: 4px;
}
